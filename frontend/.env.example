# Copy to .env and fill in for local development.
# VITE_-prefixed vars are inlined into the browser bundle at build time —
# never put secrets here, only public/client-safe values.

# FastAPI backend base URL (browser-facing)
VITE_API_BASE_URL=http://localhost:8000/api

# Google Maps JavaScript API key baked into the frontend bundle at build time
# (powers the property map on /search and the homepage). Restrict this key
# to your domain(s) in the Google Cloud Console — it is public once shipped.
VITE_GOOGLE_MAPS_API_KEY=
