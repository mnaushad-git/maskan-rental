# ── REQUIRED — must be set before first deploy ───────────────────────────────

# Your domain (no trailing slash)
FRONTEND_ORIGIN=https://maskan.sa

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# PostgreSQL credentials — use strong random passwords
DB_USER=maskan_app
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_NAME=maskan

# Your admin email(s) — comma-separated, no spaces
# These accounts get admin access in the portal
ADMIN_EMAILS=mnaushad.aws@gmail.com

# Anthropic API key for AI advisor
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL — stub-safe, activate when you have the keys ────────────────────

# Email notifications via SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@maskan.sa

# Moyasar payment gateway (Saudi payment processor)
# https://moyasar.com
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Google Places + Maps (for Area Intelligence live data)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
