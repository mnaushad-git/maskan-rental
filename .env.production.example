# ── REQUIRED — must be set before first deploy ───────────────────────────────

# Your domain (no trailing slash) — full URL, used by the app + CORS
FRONTEND_ORIGIN=https://maskanai.com

# Same domain as a bare hostname (no scheme) — Caddy fetches the TLS cert for it
DOMAIN=maskanai.com

# Email Let's Encrypt uses for certificate expiry / problem notices
ACME_EMAIL=mnaushad.aws@gmail.com

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# PostgreSQL credentials — use strong random passwords
DB_USER=maskan_app
DB_PASSWORD=CHANGE_ME_strong_random_password
DB_NAME=maskan

# Your admin email(s) — comma-separated, no spaces
# These accounts get admin access in the portal
ADMIN_EMAILS=mnaushad.aws@gmail.com

# Anthropic API key for AI advisor
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL — stub-safe, activate when you have the keys ────────────────────

# Email notifications via SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@maskanai.com

# Moyasar payment gateway (Saudi payment processor)
# https://moyasar.com
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Google Places + Maps (for Area Intelligence live data — server-side calls)
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google Maps JavaScript API key baked into the frontend bundle at build time
# (powers the property map on /search and the homepage). Can be the same key
# as GOOGLE_MAPS_API_KEY above, but must be its own var since only VITE_-
# prefixed vars are exposed to browser code by Vite.
VITE_GOOGLE_MAPS_API_KEY=

# ── Notification Platform (real push delivery) ────────────────────────────────
# Push is OFF by default (FEATURE_PUSH_NOTIFICATIONS=false) until this section
# is filled in — every notification still gets created and shown in-app either
# way, this only gates the push channel. See DEPLOY.md "Push Notifications"
# for the exact Expo/EAS credential steps this unblocks.
FEATURE_PUSH_NOTIFICATIONS=false
PUSH_PROVIDER=expo
# Optional: raises Expo's per-project push send rate limit. Get one from
# https://expo.dev/accounts/<account>/settings/access-tokens after EAS is set
# up for the mobile app (see mobile/eas.json — needs a real EAS project id
# from `eas init`, which is the actual blocking step, not this token).
EXPO_ACCESS_TOKEN=
ENVIRONMENT_NAME=production
