# Copy to .env and fill in. EXPO_PUBLIC_-prefixed vars are inlined into the
# JS bundle at build time (mirrors the frontend/'s VITE_ convention).

# FastAPI backend base URL. Use your machine's LAN IP (not localhost) when
# testing on a physical device via Expo Go, e.g. http://192.168.1.20:8000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Used by the JS Google Places/Geocoding calls, if any are added later.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Native Android Google Maps SDK key — goes in app.json's
# android.config.googleMaps.apiKey (app.json can't read env vars directly;
# paste the key there before an Android build, or convert to app.config.js).
